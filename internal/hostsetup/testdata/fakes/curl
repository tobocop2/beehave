#!/bin/sh
# Fake curl: copy the file of FAKE_DL named for the URL to the -o path. The go.dev list is go.json.
# It refuses an -o path outside the folder of the test.
printf 'curl %s\n' "$*" >>"$FAKE_LOG"
out=
url=
while [ $# -gt 0 ]; do
	case $1 in
	-o | --retry | -H | -w | --max-time)
		[ "$1" = -o ] && out=$2
		shift 2
		;;
	-*) shift ;;
	*)
		url=$1
		shift
		;;
	esac
done
# A metadata URL: root gets FAKE_METADATA_ROOT_CODE (200). The login user gets FAKE_METADATA_USER_CODE (000) and exits FAKE_METADATA_USER_RC (7);
# the IPv6 URL reads FAKE_METADATA_USER6_CODE and FAKE_METADATA_USER6_RC instead, when they are set.
case $url in
http://169.254.169.254/computeMetadata/v1/instance/service-accounts/default/token | 'http://[fd20:ce::254]/computeMetadata/v1/instance/service-accounts/default/token')
	if [ -n "${FAKE_AS_ROOT:-}" ]; then
		printf '%s' "${FAKE_METADATA_ROOT_CODE:-200}"
		exit 0
	fi
	code=${FAKE_METADATA_USER_CODE:-000}
	rc=${FAKE_METADATA_USER_RC:-7}
	if [ "${url#http://169.254.169.254/}" = "$url" ]; then
		code=${FAKE_METADATA_USER6_CODE:-$code}
		rc=${FAKE_METADATA_USER6_RC:-$rc}
	fi
	printf '%s' "$code"
	exit "$rc"
	;;
esac
# The HTTPS endpoint on port 443 answers like the HTTP one: FAKE_METADATA_TLS_CODE (000) and FAKE_METADATA_TLS_RC (7), and the IPv6 URL
# reads FAKE_METADATA_TLS6_CODE and FAKE_METADATA_TLS6_RC when they are set.
case $url in
https://169.254.169.254/computeMetadata/v1/instance/service-accounts/default/token | 'https://[fd20:ce::254]/computeMetadata/v1/instance/service-accounts/default/token')
	code=${FAKE_METADATA_TLS_CODE:-000}
	rc=${FAKE_METADATA_TLS_RC:-7}
	if [ "${url#https://169.254.169.254/}" = "$url" ]; then
		code=${FAKE_METADATA_TLS6_CODE:-$code}
		rc=${FAKE_METADATA_TLS6_RC:-$rc}
	fi
	printf '%s' "$code"
	exit "$rc"
	;;
esac
case $url in
*mode=json*) name=go.json ;;
*) name=${url##*/} ;;
esac
if [ ! -f "$FAKE_DL/$name" ]; then
	echo "fake curl: no download $name" >&2
	exit 22
fi
"$FAKE_BIN/fake-path-guard" curl "$out" || exit 1
cp "$FAKE_DL/$name" "$out"
