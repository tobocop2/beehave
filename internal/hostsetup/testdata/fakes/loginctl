#!/bin/sh
# Fake loginctl: linger of a user is on once enable-linger <user> made the marker file linger-<user>.
printf 'loginctl %s\n' "$*" >>"$FAKE_LOG"
case $1 in
enable-linger) : >"$FAKE_STATE/linger-$2" ;;
show-user) if [ -f "$FAKE_STATE/linger-$2" ]; then echo Linger=yes; else echo Linger=no; fi ;;
*)
	echo "fake loginctl: unexpected $*" >&2
	exit 1
	;;
esac
