#!/bin/sh
# Fake sudo: log the call, and run the command only when it is a fake of the test. A real command never runs.
# FAKE_SUDO_PARTIAL stands for an entry without a password for some commands only: sudo -n -l succeeds and sudo -n true fails.
printf 'sudo %s\n' "$*" >>"$FAKE_LOG"
if [ "$1" = -n ]; then
	[ ! -f "$FAKE_STATE/sudo-granted" ] || exit 0
	[ "$*" != '-n -l' ] || [ -z "${FAKE_SUDO_PARTIAL:-}" ] || exit 0
	exit "${FAKE_SUDO_RC:-1}"
fi
case $1 in *=*) shift ;; esac
if [ "$1" = -u ]; then
	shift 2
else
	export FAKE_AS_ROOT=1
fi
case $(command -v "$1") in "$FAKE_BIN"/*) exec "$@" ;; esac
exit 0
