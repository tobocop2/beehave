#!/bin/sh
# Fake id: the login user builder, with the user id from FAKE_UID (FAKE_LOGIN_UID, the user that runs the test, by default) and the groups
# from FAKE_GROUPS (builder).
# `id -u beehest-jobs` and `id -nG beehest-jobs` read the job user: it exists once the fake useradd made the file jobuser in FAKE_STATE,
# and its groups are FAKE_JOB_GROUPS (beehest-jobs).
user=
for arg; do
	case $arg in
	-*) ;;
	*) user=$arg ;;
	esac
done
if [ -n "$user" ]; then
	[ "$user" = beehest-jobs ] && [ -f "$FAKE_STATE/jobuser" ] || {
		echo "id: '$user': no such user" >&2
		exit 1
	}
	groups=${FAKE_JOB_GROUPS:-beehest-jobs}
	uid=1001
else
	groups=${FAKE_GROUPS:-builder}
	uid=${FAKE_UID:-${FAKE_LOGIN_UID:?fake id: FAKE_LOGIN_UID, the user id of the test, is not set}}
fi
case $1 in
-u) echo "$uid" ;;
-un | -gn) echo builder ;;
-nG) echo "$groups" ;;
*)
	echo "fake id: unexpected $*" >&2
	exit 1
	;;
esac
